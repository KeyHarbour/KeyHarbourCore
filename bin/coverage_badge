#!/usr/bin/env ruby

require "json"

coverage = JSON.parse(File.read("coverage/coverage.json"))
percentage = coverage.dig("total", "lines", "percent").to_f.round(2)

File.write("coverage.svg", <<~SVG)
  <svg xmlns="http://www.w3.org/2000/svg" width="150" height="20">
    <rect width="150" height="20" rx="3" fill="#555"/>
    <rect x="70" width="80" height="20" rx="3" fill="#4c1"/>
    <text x="35" y="14" fill="#fff" text-anchor="middle"
          font-family="Verdana,Arial,sans-serif" font-size="11">
      coverage
    </text>
    <text x="110" y="14" fill="#fff" text-anchor="middle"
          font-family="Verdana,Arial,sans-serif" font-size="11">
      #{percentage}%
    </text>
  </svg>
SVG

puts "Coverage badge: #{percentage}%"